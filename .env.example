# WORKHUB environment variables.
# Copy this file to `.env` (git-ignored) and fill in values. Read by:
#   - Docker Compose (automatically, from the repo root)
#   - the Spring Boot backend (spring.config.import in application.properties)
# A commented-out variable falls back to the default noted next to it.
# Do NOT leave a variable present but empty (e.g. `JWT_SECRET=`): an empty value overrides the default.

# ---------- Database (PostgreSQL, used with SPRING_PROFILES_ACTIVE=postgres) ----------
# Host port published by docker-compose. If you change it, set DB_URL to the same port.
POSTGRES_PORT=5433
DB_USERNAME=workhub
DB_PASSWORD=workhub
# Default: jdbc:postgresql://localhost:5433/workhub
# DB_URL=jdbc:postgresql://localhost:5433/workhub

# ---------- Auth ----------
# HS256 signing key for access tokens, at least 32 bytes. Required outside local development.
# Generate one with: openssl rand -base64 48
# Default (dev only, insecure): a built-in placeholder.
# JWT_SECRET=

# Base URL of the frontend, used in links sent by email (verify email, reset password).
FRONTEND_BASE_URL=http://localhost:5173

# Set to true when the app is served over HTTPS (production), so the refresh cookie is Secure.
REFRESH_COOKIE_SECURE=false

# ---------- Production (docker-compose.prod.yml, SPRING_PROFILES_ACTIVE=prod) ----------
# The prod profile refuses to start without JWT_SECRET, with REFRESH_COOKIE_SECURE=false, or with a non-https
# FRONTEND_BASE_URL. docker-compose.prod.yml forces REFRESH_COOKIE_SECURE=true and requires JWT_SECRET, DB_PASSWORD
# and FRONTEND_BASE_URL (e.g. https://workhub.example.com).
# Host port of the nginx container (put TLS in front of it). Default: 8081
# WEB_PORT=8081
# Sign-in/sign-up/password-reset attempts allowed per client address per minute. Default: 20
# RATE_LIMIT_AUTH_REQUESTS=20
# Set to false to switch the limiter off (not recommended). Default: true
# RATE_LIMIT_ENABLED=true
# Database connection pool size of the backend. Default: 10
# DB_POOL_SIZE=10

# ---------- Email (SMTP) ----------
# MAIL_ENABLED=false (default): emails (verification, password reset, invitations, notifications) are only written to
# the backend log. Set it to true and fill in your SMTP provider (Gmail App Password, SendGrid, Amazon SES, Mailgun...).
# Port 587 uses STARTTLS. Sending runs in the background; a failure is logged and never fails the request.
MAIL_ENABLED=false
# Sender shown to recipients, e.g. WORKHUB <no-reply@your-domain.com> (must be allowed by your provider)
MAIL_FROM=no-reply@workhub.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
