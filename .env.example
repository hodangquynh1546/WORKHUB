# WORKHUB environment variables.
# Copy this file to `.env` (git-ignored) and fill in values. Read by:
#   - Docker Compose (automatically, from the repo root)
#   - the Spring Boot backend (spring.config.import in application.properties)
# A commented-out variable falls back to the default noted next to it.
# Do NOT leave a variable present but empty (e.g. `JWT_SECRET=`): an empty value overrides the default.

# ---------- Database (PostgreSQL, used with SPRING_PROFILES_ACTIVE=postgres) ----------
# Host port published by docker-compose. If you change it, set DB_URL to the same port.
POSTGRES_PORT=5433
DB_USERNAME=workhub
DB_PASSWORD=workhub
# Default: jdbc:postgresql://localhost:5433/workhub
# DB_URL=jdbc:postgresql://localhost:5433/workhub

# ---------- Auth ----------
# HS256 signing key for access tokens, at least 32 bytes. Required outside local development.
# Generate one with: openssl rand -base64 48
# Default (dev only, insecure): a built-in placeholder.
# JWT_SECRET=

# Base URL of the frontend, used in links sent by email (verify email, reset password).
FRONTEND_BASE_URL=http://localhost:5173

# Set to true when the app is served over HTTPS (production), so the refresh cookie is Secure.
REFRESH_COOKIE_SECURE=false
